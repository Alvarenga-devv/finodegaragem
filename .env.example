# ============================================================================
# FINO DE GARAGEM — Variáveis de ambiente (exemplo)
# Nunca commitar um .env real. Chaves secretas/service_role NUNCA vão para
# o front-end — apenas para funções server-side (Edge Functions/servidor).
# ============================================================================

# Supabase (banco de dados + autenticação)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta — uso exclusivo em backend/Edge Functions, nunca no front-end:
SUPABASE_SERVICE_ROLE_KEY=

# Gateway de pagamento (ex.: Mercado Pago) — uso exclusivo server-side
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_ACCESS_TOKEN=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# WhatsApp (API oficial ou provedor como Twilio/Z-API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_NUMBER=5531999973676

# E-mail transacional (ex.: Resend/SendGrid)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=contato@finodegaragem.com.br

# App
APP_BASE_URL=https://www.finodegaragem.com.br
